# Copy these entries into your PowerShell session before starting the backend.
# Use a real PostgreSQL database; these defaults match a fresh local install.
$env:DB_URL = "jdbc:postgresql://localhost:5432/xllent_food"
$env:DB_USERNAME = "postgres"
$env:DB_PASSWORD = "postgres"
$env:JWT_SECRET = "replace-with-a-32-character-or-longer-secret"
$env:JWT_EXPIRATION = "86400000"
$env:FRONTEND_URL = "http://localhost:5173"

# Creates this account only when it does not already exist.
$env:BOOTSTRAP_SUPER_ADMIN_ENABLED = "true"
$env:SUPER_ADMIN_EMAIL = "superadmin@xllentretailers.com"
$env:SUPER_ADMIN_PASSWORD = "SuperAdmin@123"

# Optional until image-upload functionality is used.
$env:CLOUDINARY_CLOUD_NAME = ""
$env:CLOUDINARY_API_KEY = ""
$env:CLOUDINARY_API_SECRET = ""
